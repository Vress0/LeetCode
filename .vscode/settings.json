{
    "files.defaultLanguage": "cpp", 
    "editor.formatOnType": true, 
    "editor.snippetSuggestions": "top",
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
      "c": "cd \"$dir\" && out=\"${TMPDIR:-/tmp}/leetcode-run/$fileNameWithoutExt\" && mkdir -p \"$(dirname \"$out\")\" && trap 'rm -f \"$out\"' EXIT && clang \"$fileName\" -o \"$out\" -Wall -Og -fcolor-diagnostics -std=c11 && \"$out\"",
      "cpp": "cd \"$dir\" && out=\"${TMPDIR:-/tmp}/leetcode-run/$fileNameWithoutExt\" && mkdir -p \"$(dirname \"$out\")\" && trap 'rm -f \"$out\"' EXIT && clang++ \"$fileName\" -o \"$out\" -Wall -Og -fcolor-diagnostics -std=c++17 && \"$out\""
    }, 
    "code-runner.saveFileBeforeRun": true, 
    "code-runner.preserveFocus": true, 
    "code-runner.clearPreviousOutput": false, 
    "C_Cpp.clang_format_sortIncludes": true,
    "C_Cpp.intelliSenseEngine": "Default", 
    "C_Cpp.errorSquiggles": "Disabled", 
    "C_Cpp.autocomplete": "Disabled",
    "clang.cflags": [
      "-std=c11",
      "-Wall"
    ],
    "clang.cxxflags": [ 
      "-std=c++17",
      "-Wall"
    ],
    "clang.completion.enable": true 
  }
