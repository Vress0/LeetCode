{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile", 
      "command": "mkdir -p /tmp/leetcode-vscode && clang++ \"${file}\" -o \"/tmp/leetcode-vscode/${fileBasenameNoExtension}\" -g -Og -Wall -fcolor-diagnostics -std=c++17", 
      "type": "shell", 
      "group": {
        "kind": "build",
        "isDefault": true 
      },
      "presentation": {
        "echo": true,
        "reveal": "always", 
        "focus": false, 
        "panel": "shared" 
      }
      // "problemMatcher":"$gcc" 
    },
    {
      "label": "Clean Compile Output",
      "command": "rm -rf \"/tmp/leetcode-vscode/${fileBasenameNoExtension}\" \"/tmp/leetcode-vscode/${fileBasenameNoExtension}.dSYM\"",
      "type": "shell",
      "problemMatcher": []
    }
  ]
}
